<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskTracker.MetersPage"
             Title="Meters">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="Meters" Style="{StaticResource Headline}" />

            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                HorizontalOptions="Center" />

            <SearchBar
                Placeholder="Search by name or number"
                Text="{Binding SearchText}" />

            <Button Text="New Meter" Clicked="OnNewMeterClicked" />

            <CollectionView ItemsSource="{Binding Meters}"
                            HeightRequest="600"
                            SelectionMode="Single"
                            SelectionChanged="OnMeterSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,6">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding Category}" TextColor="{StaticResource Gray500}" />
                                <Label Text="{Binding Number}" TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView
                ItemsSource="{Binding Pages}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Text="{Binding .}"
                            Padding="12,6"
                            CommandParameter="{Binding .}"
                            Clicked="OnPageButtonClicked" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
